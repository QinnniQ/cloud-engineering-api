# Copy this file to terraform.tfvars for local use.
# terraform.tfvars is intentionally ignored by Git.

aws_region = "eu-central-1"

# Replace with your current public IPv4 address in /32 CIDR notation.
trusted_ip = "203.0.113.10/32"

# Optional overrides:
# project_name        = "cloud-engineering-api"
# instance_type       = "t3.micro"
# key_name            = "cloud-engineering-lab-key"
# vpc_cidr            = "10.0.0.0/16"
# public_subnet_cidr  = "10.0.1.0/24"
# private_subnet_cidr = "10.0.2.0/24"
